---
import '../styles/global.css';
const disciplines = [
  ['01', 'Direction', 'Product strategy, positioning, and a plan with edges.'],
  ['02', 'Design', 'Identity and interfaces built as one coherent system.'],
  ['03', 'Engineering', 'Production software with tests, history, and proof.'],
  ['04', 'Review', 'Independent checks before anything earns your approval.'],
];
const agents = [
  ['CTO', 'Sets the technical direction'],
  ['PRODUCT', 'Turns intent into a usable brief'],
  ['ARCHITECT', 'Defines the system before the build'],
  ['ENGINEERING', 'Ships the working product'],
  ['QA + REVIEW', 'Tries to break it before users do'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e3e7eb" />
    <meta name="description" content="ARVIS is a creative technology company building distinctive brands, digital products, and ADA AGENT." />
    <meta property="og:title" content="ARVIS — Ideas into working systems" />
    <meta property="og:description" content="Strategy, design, engineering, and proof in one visible process." />
    <title>ARVIS — Ideas into working systems</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%2317191a'/%3E%3Cpath d='M13 49 27 14h10l14 35H40l-2.8-8H26.4l-2.8 8Zm16-17h5.6L32 23.7Z' fill='%23ff5f14'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="loader" aria-hidden="true"><span>ARVIS / LOADING</span><b>00</b></div>
    <header class="topbar">
      <a class="brand" href="#home" aria-label="ARVIS home">ARVIS<sup>®</sup></a>
      <p>CREATIVE TECHNOLOGY STUDIO<br />INDIA / WORLDWIDE</p>
      <nav aria-label="Main navigation"><a href="#ada">ADA AGENT</a><a href="#practice">PRACTICE</a><a class="nav-cta" href="#contact">START A PROJECT ↗</a></nav>
      <button class="menu" type="button" aria-label="Toggle navigation" aria-expanded="false">MENU</button>
    </header>
    <main>
      <section class="hero ruled" id="home">
        <div class="hero-meta meta-left">INDEPENDENT STUDIO<br />EST. 2026</div>
        <div class="hero-meta meta-mid">STRATEGY + DESIGN + ENGINEERING<br /><span>BUILT AS ONE SYSTEM</span></div>
        <div class="hero-intro">We turn impatient ideas into brands and working software. Clear decisions, careful execution, and proof you can inspect.<a href="#contact">BEGIN THE WORK ↗</a></div>
        <div class="instrument" aria-label="Four specialist disciplines"><strong>04</strong><span>DISCIPLINES<br />IN ONE RUN</span></div>
        <h1><span>ARVIS</span><span>INTELLIGENCE</span></h1>
        <div class="hero-bottom"><span>IDEAS INTO WORKING SYSTEMS</span><span>SCROLL TO INSPECT ↓</span></div>
      </section>
      <section class="film" aria-label="Studio process film">
        <video autoplay muted loop playsinline preload="metadata" poster="https://images.pexels.com/videos/9617184/pexels-photo-9617184.jpeg?auto=compress&cs=tinysrgb&w=1600"><source src="https://videos.pexels.com/video-files/9617184/9617184-uhd_4096_2160_25fps.mp4" type="video/mp4" /></video>
        <div class="film-wash"></div><div class="film-caption"><span>01 / THE PRACTICE</span><strong>Good work starts<br />with close attention.</strong><small>4K FILM / RON LACH VIA PEXELS</small></div>
      </section>
      <section class="statement ruled" id="practice">
        <div class="section-tag">WHAT WE DO / 01—04</div><h2>Not more output.<br /><em>Better decisions.</em></h2>
        <p class="statement-copy">ARVIS works where identity, interface, and engineering meet. No relay race between departments. The people shaping the idea stay close to the people making it real.</p>
        <div class="discipline-list">{disciplines.map(([number, title, copy]) => <article><span>{number}</span><h3>{title}</h3><p>{copy}</p><b>↗</b></article>)}</div>
      </section>
      <section class="ada" id="ada">
        <div class="ada-head"><span>PRODUCT / IN DEVELOPMENT</span><span>ADA AGENT / 2026</span></div>
        <div class="ada-title"><p>One brief.<br />A complete product team.</p><h2>ADA<br />AGENT<sup>01</sup></h2></div>
        <div class="ada-body"><div class="ada-screen" aria-label="Illustrative ADA project run">
          <div class="screen-bar"><span>RUN / 0042</span><span><i></i> ACTIVE</span></div><p class="screen-prompt">“Build a focused workspace for small creative teams. Make it calm, fast, and easy to trust.”</p>
          <ol><li><span>01</span><strong>System plan published</strong><b>DONE</b></li><li><span>02</span><strong>Interface build complete</strong><b>DONE</b></li><li class="is-live"><span>03</span><strong>Acceptance tests running</strong><b>LIVE</b></li></ol>
        </div><div class="ada-copy"><p>ADA is the product team we are building for founders who need movement without losing control. Specialist agents plan, build, test, and review in one visible run.</p><a href="#contact">REQUEST EARLY ACCESS ↗</a></div></div>
      </section>
      <section class="agents ruled">
        <div class="section-tag">THE SYSTEM / SPECIALISTS</div><div class="agents-intro"><h2>Many minds.<br />One mission.</h2><p>Different responsibilities. Shared context. A single trail of decisions.</p></div>
        <div class="agent-index">{agents.map(([name, role], index) => <div><span>0{index + 1}</span><strong>{name}</strong><p>{role}</p></div>)}</div>
      </section>
      <section class="split-film">
        <div class="split-copy"><span>HUMAN / MACHINE</span><h2>Technology<br />with a pulse.</h2><p>The system handles coordination. Taste, judgment, and the final call stay human.</p></div>
        <figure><video autoplay muted loop playsinline preload="none" poster="https://images.pexels.com/videos/9465403/pexels-photo-9465403.jpeg?auto=compress&cs=tinysrgb&w=1200"><source src="https://videos.pexels.com/video-files/9465403/9465403-uhd_3840_2160_25fps.mp4" type="video/mp4" /></video><figcaption>02 / HUMAN SIGNAL — 4K FILM / ROCKETMANN TEAM VIA PEXELS</figcaption></figure>
      </section>
      <section class="proof"><p>THE STANDARD</p><h2>Less “trust me.”<br /><span>More evidence.</span></h2><div><span>WORKING BUILD</span><span>TEST RESULTS</span><span>REVIEW NOTES</span><span>YOUR APPROVAL</span></div></section>
      <section class="contact ruled" id="contact"><div class="section-tag">NEW BUSINESS / OPEN</div><p>Have an idea that<br />will not sit still?</p><a href="mailto:hello@arvis.studio"><span>LET’S MAKE IT</span><b>↗</b></a><div class="contact-foot"><span>HELLO@ARVIS.STUDIO</span><span>BUILT IN INDIA / WORKING EVERYWHERE</span></div></section>
    </main>
    <aside class="system-status" aria-label="ADA system status and preview usage">
      <span class="system-status__signal"></span>
      <div><small>SYSTEM STATUS</small><strong>ONLINE</strong></div>
      <i aria-hidden="true"><b></b></i>
      <div class="system-status__usage"><small>USAGE</small><strong>18<em>/100</em></strong></div>
    </aside>
    <footer><a href="#home">ARVIS<sup>®</sup></a><p>© 2026 / ALL IDEAS IN MOTION</p><a href="#home">TOP ↑</a></footer>
    <script src="../scripts/site.js"></script>
  </body>
</html>
