---
import '../styles/global.css';
import adaMark from '../assets/ada-wild-dog-mark-concept.png';
const disciplines = [
  ['01', 'Direction', 'Product strategy, positioning, and a plan with edges.'],
  ['02', 'Design', 'Identity and interfaces built as one coherent system.'],
  ['03', 'Engineering', 'Production software with tests, history, and proof.'],
  ['04', 'Review', 'Independent checks before anything earns your approval.'],
];
const agents = [
  ['CTO', 'Sets the technical direction'],
  ['PRODUCT', 'Turns intent into a usable brief'],
  ['ARCHITECT', 'Defines the system before the build'],
  ['ENGINEERING', 'Ships the working product'],
  ['QA + REVIEW', 'Tries to break it before users do'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e3e7eb" />
    <meta name="description" content="ARVIS is a creative technology company building distinctive brands, digital products, and ADA AGENT." />
    <meta property="og:title" content="ARVIS — Ideas into working systems" />
    <meta property="og:description" content="Strategy, design, engineering, and proof in one visible process." />
    <title>ARVIS — Ideas into working systems</title>
    <link rel="icon" type="image/png" href={adaMark.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="loader" aria-hidden="true"><span>ARVIS / LOADING</span><b>00</b></div>
    <header class="topbar">
      <a class="brand" href="#home" aria-label="ARVIS home">ARVIS<sup>®</sup></a>
      <p>CREATIVE TECHNOLOGY STUDIO<br />INDIA / WORLDWIDE</p>
      <nav aria-label="Main navigation"><a href="#ada">ADA AGENT</a><a href="#practice">PRACTICE</a><a class="nav-cta" href="#contact">START A PROJECT ↗</a></nav>
      <button class="menu" type="button" aria-label="Toggle navigation" aria-expanded="false">MENU</button>
    </header>
    <main>
      <section class="hero ruled" id="home">
        <div class="hero-meta meta-left">INDEPENDENT STUDIO<br />EST. 2026</div>
        <div class="hero-meta meta-mid">STRATEGY + DESIGN + ENGINEERING<br /><span>BUILT AS ONE SYSTEM</span></div>
        <div class="hero-intro">We turn impatient ideas into brands and working software. Clear decisions, careful execution, and proof you can inspect.<a href="#contact">BEGIN THE WORK ↗</a></div>
        <div class="hero-index" aria-label="Four specialist disciplines"><span>DISCIPLINES</span><strong>04</strong><small>ONE CONTINUOUS PRACTICE</small></div>
        <h1><span>ARVIS</span><span>INTELLIGENCE</span></h1>
        <div class="hero-bottom"><span>IDEAS INTO WORKING SYSTEMS</span><span>SCROLL TO INSPECT ↓</span></div>
      </section>
      <section class="film" aria-label="Studio process film">
        <video class="smart-video" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/18382358/black-screen-computer-laptop-dell-hacker-18382358.jpeg?auto=compress&cs=tinysrgb&h=900&fit=crop&w=1600" data-src-hd="https://videos.pexels.com/video-files/18382358/18382358-hd_1920_1080_25fps.mp4"></video>
        <div class="film-wash"></div><div class="film-caption"><span>01 / THE SOFTWARE</span><strong>Software should<br />show its work.</strong></div>
      </section>
      <section class="statement ruled" id="practice">
        <div class="section-tag">WHAT WE DO / 01—04</div><h2>Not more output.<br /><em>Better decisions.</em></h2>
        <p class="statement-copy">ARVIS works where identity, interface, and engineering meet. No relay race between departments. The people shaping the idea stay close to the people making it real.</p>
        <div class="discipline-list">{disciplines.map(([number, title, copy]) => <article><span>{number}</span><h3>{title}</h3><p>{copy}</p><b>↗</b></article>)}</div>
      </section>
      <section class="process-reel" aria-label="ARVIS working process">
        <div class="process-sticky">
          <div class="process-counter"><span>PROCESS FILMS</span><b>01 / 03</b></div>
          <div class="process-track">
            <article class="process-panel process-panel--intro">
              <span>THE WORK / IN MOTION</span>
              <h2>Think.<br />Make.<br /><em>Prove.</em></h2>
              <p>Three movements. One continuous line from first question to tested product.</p>
            </article>
            <article class="process-panel process-panel--film">
              <video class="smart-video" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/8004278/pexels-photo-8004278.jpeg?auto=compress&cs=tinysrgb&w=1600" data-src-hd="https://videos.pexels.com/video-files/8004278/8004278-hd_1920_1080_25fps.mp4"></video>
              <div class="process-panel__shade"></div><div class="process-panel__copy"><span>01 / THINK TOGETHER</span><h3>The right question<br />before the first line.</h3></div>
            </article>
            <article class="process-panel process-panel--film">
              <video class="smart-video" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/29758709/art-artist-business-computer-29758709.jpeg?auto=compress&cs=tinysrgb&h=900&fit=crop&w=1600" data-src-hd="https://videos.pexels.com/video-files/29758709/12789425_1920_1080_25fps.mp4"></video>
              <div class="process-panel__shade"></div><div class="process-panel__copy"><span>02 / DESIGN THE SYSTEM</span><h3>Turn intent into<br />interaction.</h3></div>
            </article>
            <article class="process-panel process-panel--outro">
              <span>03 / PROVE THE RESULT</span><h2>Evidence<br />ends the<br /><em>argument.</em></h2><a href="#ada">SEE THE SYSTEM ↓</a>
            </article>
          </div>
        </div>
      </section>
      <section class="ada" id="ada">
        <div class="ada-head"><span>PRODUCT / IN DEVELOPMENT</span><span>ADA AGENT / 2026</span></div>
        <div class="ada-title"><p>One brief.<br />A complete product team.</p><h2>ADA<br />AGENT<sup>01</sup></h2></div>
        <div class="ada-body"><div class="ada-screen" aria-label="Illustrative ADA project run">
          <div class="screen-bar"><span>RUN / 0042</span><span><i></i> ACTIVE</span></div><p class="screen-prompt">“Build a focused workspace for small creative teams. Make it calm, fast, and easy to trust.”</p>
          <ol><li><span>01</span><strong>System plan published</strong><b>DONE</b></li><li><span>02</span><strong>Interface build complete</strong><b>DONE</b></li><li class="is-live"><span>03</span><strong>Acceptance tests running</strong><b>LIVE</b></li></ol>
        </div><div class="ada-copy"><p>ADA is the product team we are building for founders who need movement without losing control. Specialist agents plan, build, test, and review in one visible run.</p><a href="#contact">REQUEST EARLY ACCESS ↗</a></div></div>
      </section>
      <section class="ada-identity" aria-label="ADA brand mascot">
        <div class="ada-identity__sticky">
          <div class="ada-identity__meta"><span>IDENTITY / 001</span><span>THE PACK INTELLIGENCE</span></div>
          <div class="ada-identity__mark" data-ada-mark>
            <span class="ada-identity__scan" aria-hidden="true"></span>
            <img src={adaMark.src} alt="ADA African wild dog pixel mark" width="1263" height="1246" />
          </div>
          <div class="ada-identity__story">
            <p>WHY THE WILD DOG</p>
            <h2>Listen wide.<br />Move as one.</h2>
            <div><span>01 / CONTEXT</span><p>Large ears. Nothing important gets lost between the brief and the build.</p></div>
            <div><span>02 / COORDINATION</span><p>Distinct specialists work as one pack, without giving up their role.</p></div>
            <div><span>03 / ENDURANCE</span><p>ADA stays with the problem from first decision to tested software.</p></div>
          </div>
        </div>
      </section>
      <section class="agents ruled">
        <div class="section-tag">THE SYSTEM / SPECIALISTS</div><div class="agents-intro"><h2>Many minds.<br />One mission.</h2><p>Different responsibilities. Shared context. A single trail of decisions.</p></div>
        <div class="agent-index">{agents.map(([name, role], index) => <div><span>0{index + 1}</span><strong>{name}</strong><p>{role}</p></div>)}</div>
      </section>
      <section class="material-films" aria-label="Product pipeline films">
        <div class="material-films__head"><span>PRODUCT PIPELINE / 01—03</span><p>ADA connects the work that usually fragments: interface decisions, implementation, and technical verification.</p></div>
        <figure class="material-film material-film--wide"><div><video class="smart-video" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/2110240/free-video-2110240.jpg?auto=compress&cs=tinysrgb&h=900&fit=crop&w=1600" data-src-hd="https://videos.pexels.com/video-files/2110240/2110240-hd_1920_1080_25fps.mp4"></video></div></figure>
        <aside class="material-story"><span>FROM REQUIREMENT TO REPOSITORY</span><h3>One visible line of thought.</h3><p>ADA keeps the brief, implementation, tests, and review in the same working context. Each specialist can see what changed, why it changed, and what still needs a human decision.</p><figure class="material-film material-film--mini"><div><video class="smart-video" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/8632599/pexels-photo-8632599.jpeg?auto=compress&cs=tinysrgb&w=900" data-src-hd="https://videos.pexels.com/video-files/8632599/8632599-hd_1920_1080_25fps.mp4"></video></div></figure></aside>
        <figure class="material-film material-film--full"><div><video class="smart-video" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/6804110/pexels-photo-6804110.jpeg?auto=compress&cs=tinysrgb&w=1600" data-src-hd="https://videos.pexels.com/video-files/6804110/6804110-uhd_2732_1440_25fps.mp4" data-src-4k="https://videos.pexels.com/video-files/6804110/6804110-uhd_4096_2160_25fps.mp4"></video></div><figcaption><span>03 / REVIEW</span><span>SHARED CONTEXT, VISIBLE DECISIONS</span></figcaption></figure>
      </section>
      <section class="split-film">
        <div class="split-copy"><span>HUMAN / MACHINE</span><h2>Technology<br />with a pulse.</h2><p>The system handles coordination. Taste, judgment, and the final call stay human.</p></div>
        <figure><video class="smart-video" muted loop playsinline preload="none" poster="https://images.pexels.com/videos/10130349/computer-computer-program-program-10130349.jpeg?auto=compress&cs=tinysrgb&h=900&fit=crop&w=1200" data-src-hd="https://videos.pexels.com/video-files/10130349/10130349-hd_1920_1080_30fps.mp4"></video></figure>
      </section>
      <section class="proof"><p>THE STANDARD / 01—04</p><h2>Less “trust me.”<br /><span>More evidence.</span></h2><div class="proof-line"><span>01 / WORKING BUILD</span><span>02 / TEST RESULTS</span><span>03 / REVIEW NOTES</span><span>04 / YOUR APPROVAL</span></div></section>
      <section class="contact ruled" id="contact"><div class="section-tag">NEW BUSINESS / OPEN</div><p>Have an idea that<br />will not sit still?</p><a href="mailto:hello@arvis.studio"><span>LET’S MAKE IT</span><b>↗</b></a><div class="contact-foot"><span>HELLO@ARVIS.STUDIO</span><span>BUILT IN INDIA / WORKING EVERYWHERE</span></div></section>
    </main>
    <aside class="ada-companion" aria-label="Meet ADA">
      <button class="ada-companion__trigger" type="button" aria-expanded="false" aria-controls="ada-companion-panel">
        <img src={adaMark.src} alt="" width="72" height="72" />
        <span>ADA</span><i aria-hidden="true"></i>
      </button>
      <section class="ada-companion__panel" id="ada-companion-panel" aria-hidden="true" aria-labelledby="ada-companion-title">
        <div class="ada-companion__bar"><span>ADA / PRODUCT AGENT</span><button type="button" aria-label="Close ADA panel">CLOSE</button></div>
        <div class="ada-companion__art"><img src={adaMark.src} alt="ADA, the African wild dog pixel mascot" width="1263" height="1246" /></div>
        <div class="ada-companion__copy">
          <p>01 / MEET THE PACK</p>
          <h2 id="ada-companion-title">Sharp instincts.<br />Working software.</h2>
          <p>ADA brings product, design, engineering, and review into one visible run.</p>
          <nav aria-label="ADA actions"><a href="#ada">EXPLORE ADA <span>↓</span></a><a href="#contact">START A PROJECT <span>↗</span></a></nav>
        </div>
      </section>
    </aside>
    <div class="scroll-progress" aria-hidden="true"><i></i></div>
    <footer class="site-footer">
      <div class="site-footer__top"><span>END OF FILE / START OF THE PACK</span><a href="#home">BACK TO TOP ↑</a></div>
      <div class="pack-stage" tabindex="0" role="group" aria-label="ADA wild dog pack assembling into one mark">
        <span class="pack-stage__prompt">BRING THE CURSOR / ASSEMBLE THE PACK</span>
        <img class="pack-dog" src={adaMark.src} alt="" width="1263" height="1246" />
        <img class="pack-dog" src={adaMark.src} alt="" width="1263" height="1246" />
        <img class="pack-dog" src={adaMark.src} alt="" width="1263" height="1246" />
        <img class="pack-dog" src={adaMark.src} alt="" width="1263" height="1246" />
        <img class="pack-dog" src={adaMark.src} alt="" width="1263" height="1246" />
        <a class="pack-whole" href="#ada" aria-label="Return to ADA Agent"><img src={adaMark.src} alt="ADA wild dog mark" width="1263" height="1246" /><span>PACK / ONE SYSTEM</span></a>
      </div>
      <a class="site-footer__wordmark" href="#home">ARVIS<sup>®</sup></a>
      <p>© 2026 / ALL IDEAS IN MOTION</p>
    </footer>
    <script src="../scripts/site.js"></script>
  </body>
</html>
